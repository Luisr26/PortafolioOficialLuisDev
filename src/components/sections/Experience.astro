---
import { education, experience } from '../../data/experience';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const locale = lang === 'es' ? 'es-CO' : 'en-US';
const fmt = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return new Intl.DateTimeFormat(locale, { month: 'short', year: 'numeric' }).format(new Date(y, m - 1, 1)).replace('.', '');
};
const range = (s: string, e: string | null) => `${fmt(s)} — ${e ? fmt(e) : t('exp.present')}`;
---

<section class="section" id="experiencia" aria-labelledby="exp-h">
  <SectionHead id="exp-h" label={t('exp.label')} aside={t('exp.aside')} />

  <ol class="jobs">
    {
      experience.map((job) => (
        <li class="job">
          <div class="when mono">
            <time datetime={job.start}>{range(job.start, job.end)}</time>
          </div>
          <div class="what">
            <h3 class="company sign">{job.company}</h3>
            <p class="role">{job.role[lang]}</p>
            {job.note && <p class="note mono">{job.note[lang]}</p>}
          </div>
          <div class="detail">
            <p>{job.summary[lang]}</p>
            <ul class="tags mono" aria-label="Stack">
              {job.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="edu rv">
    <h3 class="mono edu-h">{t('edu.label')}</h3>
    <ul>
      {
        education.map((e) => (
          <li>
            <span class="edu-t">{e.title[lang]}</span>
            <span class="muted">{e.place}</span>
            <span class="mono muted">{range(e.start, e.end)}</span>
          </li>
        ))
      }
    </ul>
    <p class="mono muted lang-line">{t('edu.languages')}</p>
  </div>
</section>

<style>
  .job {
    display: grid;
    grid-template-columns: 200px 1fr 1.3fr;
    gap: clamp(16px, 3vw, 48px);
    padding: clamp(28px, 3.4vw, 44px) 0;
    position: relative;
    align-items: start;
  }
  .job::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }
  @supports (animation-timeline: view()) {
    .job::before {
      animation: draw linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 90%;
    }
    .job > * {
      animation: fade-up linear both;
      animation-timeline: view();
      animation-range: entry 15% entry 100%;
    }
  }
  @keyframes draw {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(32px); }
    to { opacity: 1; transform: none; }
  }
  .when {
    color: var(--ink-2);
    padding-top: 8px;
  }
  .company {
    font-size: clamp(40px, 5.6vw, 88px);
    transition: color 0.3s, font-variation-settings 0.5s var(--ease);
  }
  .job:hover .company {
    color: var(--accent);
    font-variation-settings: 'wdth' 90, 'wght' 900;
  }
  .role {
    margin-top: 12px;
    font-size: 17px;
    font-variation-settings: 'wdth' 90, 'wght' 600;
  }
  .note {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 11px;
  }
  .detail p {
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 58ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .tags li {
    font-size: 11px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
  }
  .edu {
    margin-top: clamp(48px, 6vw, 88px);
    border-top: 1px solid var(--ink);
    padding-top: 14px;
  }
  .edu-h {
    color: var(--ink-2);
    font-weight: 400;
    margin-bottom: 8px;
  }
  .edu li {
    display: grid;
    grid-template-columns: 1.2fr 1fr auto;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .edu-t {
    font-size: clamp(18px, 1.8vw, 24px);
    font-variation-settings: 'wdth' 85, 'wght' 650;
  }
  .lang-line {
    margin-top: 18px;
  }
  :global(.no-sda) .job > * {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.8s, transform 0.8s var(--ease);
  }
  :global(.no-sda) .job:global(.in) > * {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 900px) {
    .job {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .edu li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
