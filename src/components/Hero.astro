<script>
  // Typewriter
  var words=['soluciones con IA.','automatizaciones.','apps full-stack.','el futuro.'];
  var el=document.getElementById('tt'),wi=0,ci=0,del=false;
  function type(){
    var w=words[wi];
    if(!del){el.textContent=w.slice(0,ci+1);ci++;if(ci===w.length){del=true;setTimeout(type,2200);return;}setTimeout(type,75);}
    else{el.textContent=w.slice(0,ci-1);ci--;if(ci===0){del=false;wi=(wi+1)%words.length;setTimeout(type,500);return;}setTimeout(type,35);}
  }
  setTimeout(type,1400);

  // Particles
  var cv=document.getElementById('particles'),cx=cv.getContext('2d'),W=0,H=0;
  function rs(){W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;}rs();window.addEventListener('resize',rs);
  var ps=[];for(var i=0;i<70;i++)ps.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.4,vy:(Math.random()-.5)*.4,r:Math.random()*2+.3,a:Math.random()*.35+.08});
  var pmx=W/2,pmy=H/2;
  document.addEventListener('mousemove',function(e){pmx=e.clientX;pmy=e.clientY;});
  function draw(){
    cx.clearRect(0,0,W,H);
    for(var i=0;i<ps.length;i++){
      var p=ps[i];
      p.x+=p.vx;p.y+=p.vy;
      if(p.x<0||p.x>W)p.vx*=-1;
      if(p.y<0||p.y>H)p.vy*=-1;
      cx.beginPath();cx.arc(p.x,p.y,p.r,0,6.28);
      cx.fillStyle='rgba(100,255,218,'+p.a+')';cx.fill();
      for(var j=i+1;j<ps.length;j++){
        var dx=p.x-ps[j].x,dy=p.y-ps[j].y,d=Math.sqrt(dx*dx+dy*dy);
        if(d<140){cx.beginPath();cx.moveTo(p.x,p.y);cx.lineTo(ps[j].x,ps[j].y);cx.strokeStyle='rgba(100,255,218,'+(0.06*(1-d/140))+')';cx.lineWidth=0.5;cx.stroke();}
      }
      var dmx=p.x-pmx,dmy=p.y-pmy,md=Math.sqrt(dmx*dmx+dmy*dmy);
      if(md<130&&md>0){p.x+=(dmx/md)*2;p.y+=(dmy/md)*2;}
    }
    requestAnimationFrame(draw);
  }
  draw();
</script>