---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="description" content="Luis Orozco - AI & Automation Developer."/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <title>Luis Orozco | AI & Automation Developer</title>
  <style>
    .i18n-fade{transition:opacity .15s ease}

    /* ===================== BOT ===================== */
    @keyframes botFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
    @keyframes antPulse{0%,100%{opacity:1}50%{opacity:.2}}
    @keyframes eyePulse{0%,80%,100%{transform:scaleY(1)}88%{transform:scaleY(.08)}95%{transform:scaleY(1)}}
    @keyframes chestPulse{0%,100%{opacity:.9}50%{opacity:.3}}
    @keyframes chestRipple{0%{transform:scale(1);opacity:.25}100%{transform:scale(2.8);opacity:0}}
    @keyframes bubbleIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    @keyframes bubbleOut{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-6px)}}

    #bot-wrap{
      position:fixed;
      bottom:28px;
      right:28px;
      z-index:9990;
      display:flex;
      flex-direction:column;
      align-items:flex-end;
    }
    #bot-widget{
      cursor:pointer;
      width:68px;height:68px;
      animation:botFloat 2.8s ease-in-out infinite;
      filter:drop-shadow(0 6px 20px rgba(94,234,212,.45));
      transition:filter .25s,transform .2s;
    }
    #bot-widget:hover{
      filter:drop-shadow(0 6px 34px rgba(94,234,212,.8));
      transform:scale(1.08);
    }
    .ant-p{animation:antPulse 1.5s ease-in-out infinite}
    .eye-l{transform-origin:center;transform-box:fill-box;animation:eyePulse 5s ease-in-out infinite}
    .eye-r{transform-origin:center;transform-box:fill-box;animation:eyePulse 5s ease-in-out infinite .25s}
    .ch-c{animation:chestPulse 2s ease-in-out infinite}
    .ch-r{transform-origin:center;transform-box:fill-box;animation:chestRipple 2s ease-out infinite}

    /* Bubble — anchored to the RIGHT so it never overflows */
    #bot-bubble{
      position:absolute;
      bottom:calc(100% + 16px);
      right:0;
      background:rgba(14,26,50,.85);
      backdrop-filter:blur(16px) saturate(180%);
      -webkit-backdrop-filter:blur(16px) saturate(180%);
      border:1px solid rgba(94,234,212,.35);
      border-radius:14px 14px 2px 14px;
      padding:10px 14px;
      width:220px;
      text-align:left;
      font-size:12.5px;
      color:#e2e8f0;
      font-family:'Outfit',sans-serif;
      line-height:1.5;
      pointer-events:none;
      box-shadow:0 8px 32px rgba(0,0,0,.4),0 0 0 1px rgba(255,255,255,.04) inset,0 0 20px rgba(94,234,212,.1);
      opacity:0;
    }
    #bot-bubble.show{animation:bubbleIn .35s ease forwards;opacity:1}
    #bot-bubble.hide{animation:bubbleOut .35s ease forwards}
    /* tiny tail bottom-right */
    #bot-bubble::after{
      content:'';
      position:absolute;
      bottom:-7px;right:22px;
      width:12px;height:12px;
      background:rgba(14,26,50,.85);
      border-right:1px solid rgba(94,234,212,.35);
      border-bottom:1px solid rgba(94,234,212,.35);
      transform:rotate(45deg);
    }

    /* ===================== MODAL — LIQUID GLASS ===================== */
    @keyframes mIn{from{opacity:0;transform:scale(.96) translateY(24px)}to{opacity:1;transform:scale(1) translateY(0)}}
    @keyframes spin{to{transform:rotate(360deg)}}
    @keyframes shimmer{0%{background-position:200% center}100%{background-position:-200% center}}

    #bot-modal{
      display:none;
      position:fixed;inset:0;
      z-index:10000;
      background:rgba(2,6,23,.7);
      backdrop-filter:blur(16px) saturate(140%);
      -webkit-backdrop-filter:blur(16px) saturate(140%);
      align-items:center;justify-content:center;
      padding:20px;
    }
    #bot-modal.open{display:flex}

    /* Glass card */
    #bot-mi{
      position:relative;
      width:100%;max-width:480px;
      max-height:92vh;overflow-y:auto;
      border-radius:28px;
      background:linear-gradient(145deg,rgba(12,28,58,.72) 0%,rgba(8,15,32,.82) 100%);
      backdrop-filter:blur(40px) saturate(200%);
      -webkit-backdrop-filter:blur(40px) saturate(200%);
      border:1px solid rgba(255,255,255,.1);
      box-shadow:
        inset 0 1.5px 0 rgba(255,255,255,.12),
        inset 0 -1px 0 rgba(0,0,0,.25),
        inset 1px 0 0 rgba(255,255,255,.05),
        0 40px 80px rgba(0,0,0,.65),
        0 0 0 1px rgba(94,234,212,.06),
        0 0 80px rgba(94,234,212,.06);
      animation:mIn .35s cubic-bezier(.34,1.56,.64,1);
      scrollbar-width:thin;
      scrollbar-color:rgba(94,234,212,.2) transparent;
    }
    /* top light-refraction shine */
    #bot-mi::before{
      content:'';
      position:absolute;top:0;left:10%;right:10%;height:1px;
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);
      border-radius:50%;
      pointer-events:none;z-index:1;
    }

    /* --- Header --- */
    #bot-mh{
      padding:28px 28px 22px;
      border-bottom:1px solid rgba(255,255,255,.06);
      border-radius:28px 28px 0 0;
      position:relative;overflow:hidden;
    }
    #bot-mh::before{
      content:'';
      position:absolute;top:-60px;right:-60px;
      width:200px;height:200px;
      background:radial-gradient(circle,rgba(94,234,212,.1) 0%,transparent 65%);
      pointer-events:none;
    }
    #bot-mh::after{
      content:'';
      position:absolute;bottom:-60px;left:-60px;
      width:180px;height:180px;
      background:radial-gradient(circle,rgba(56,189,248,.07) 0%,transparent 65%);
      pointer-events:none;
    }
    .mh-badge{
      display:inline-flex;align-items:center;gap:7px;
      background:rgba(94,234,212,.07);
      border:1px solid rgba(94,234,212,.18);
      border-radius:100px;
      padding:5px 12px 5px 8px;
      margin-bottom:14px;
    }
    .mh-badge-dot{
      width:6px;height:6px;border-radius:50%;
      background:#5eead4;
      box-shadow:0 0 6px #5eead4;
      animation:chestPulse 2s ease-in-out infinite;
    }
    .mh-badge span{
      font-family:'JetBrains Mono',monospace;
      font-size:10px;text-transform:uppercase;
      letter-spacing:.1em;color:#5eead4;
    }
    #bmt{
      font-family:'Outfit',sans-serif;
      font-size:24px;font-weight:800;
      color:#f1f5f9;margin:0 0 6px;
      line-height:1.2;
    }
    #bms{font-family:'Outfit',sans-serif;font-size:13px;color:#64748b;margin:0}
    #bcl{
      position:absolute;top:18px;right:20px;
      width:34px;height:34px;
      background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.08);
      color:#475569;font-size:18px;
      border-radius:10px;
      cursor:pointer;display:flex;align-items:center;justify-content:center;
      transition:background .2s,color .2s,border-color .2s;
      line-height:1;
    }
    #bcl:hover{background:rgba(248,113,113,.12);border-color:rgba(248,113,113,.3);color:#f87171}

    /* --- Form body --- */
    #bot-mb{padding:22px 28px 28px}
    .brow{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media(max-width:480px){.brow{grid-template-columns:1fr}#bot-mb{padding:18px 20px 24px}#bot-mh{padding:22px 20px 18px}}

    .bf{margin-bottom:14px}
    .bl{
      display:block;
      font-family:'JetBrains Mono',monospace;
      font-size:10px;text-transform:uppercase;letter-spacing:.1em;
      color:rgba(100,116,139,.8);margin-bottom:7px;
      transition:color .2s;
    }
    .bf:focus-within .bl{color:rgba(94,234,212,.9)}

    .bi-wrap{position:relative}
    .bi-icon{
      position:absolute;left:13px;top:50%;transform:translateY(-50%);
      color:rgba(71,85,105,.8);font-size:12px;
      pointer-events:none;transition:color .2s;
    }
    .bf:focus-within .bi-icon{color:rgba(94,234,212,.7)}
    textarea.bi~.bi-icon,.bi-wrap:has(textarea) .bi-icon{top:15px;transform:none}

    /* Glass inputs */
    .bi{
      width:100%;box-sizing:border-box;
      background:rgba(255,255,255,.03);
      border:1px solid rgba(255,255,255,.07);
      border-radius:12px;
      padding:11px 14px 11px 36px;
      font-family:'Outfit',sans-serif;font-size:14px;
      color:#e2e8f0;outline:none;
      transition:background .2s,border-color .2s,box-shadow .2s;
      -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
    }
    .bi::placeholder{color:rgba(71,85,105,.6)}
    .bi:focus{
      background:rgba(94,234,212,.04);
      border-color:rgba(94,234,212,.4);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.05),
        0 0 0 3px rgba(94,234,212,.08),
        0 0 20px rgba(94,234,212,.05);
    }
    .bi.err{border-color:rgba(248,113,113,.5)!important;box-shadow:0 0 0 3px rgba(248,113,113,.07)!important}
    textarea.bi{resize:vertical;min-height:100px;padding-top:12px;padding-bottom:12px}

    .be{display:none;font-size:11px;color:#f87171;margin-top:5px;font-family:'Outfit',sans-serif;padding-left:2px}
    .be.show{display:block}

    /* Divider */
    .bdiv{height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.06) 20%,rgba(255,255,255,.06) 80%,transparent);margin:6px 0 18px}

    /* Glass submit button */
    #bsub{
      width:100%;padding:13px;
      background:linear-gradient(135deg,rgba(94,234,212,.92) 0%,rgba(56,189,248,.9) 100%);
      -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
      border:1px solid rgba(255,255,255,.3);
      border-radius:12px;
      color:#0a1628;
      font-family:'Outfit',sans-serif;font-size:14px;font-weight:700;
      text-transform:uppercase;letter-spacing:.08em;
      cursor:pointer;
      box-shadow:
        inset 0 1.5px 0 rgba(255,255,255,.45),
        inset 0 -1px 0 rgba(0,0,0,.1),
        0 8px 32px rgba(94,234,212,.28),
        0 2px 8px rgba(0,0,0,.2);
      transition:opacity .2s,transform .15s,box-shadow .2s;
      position:relative;overflow:hidden;
    }
    #bsub::after{
      content:'';
      position:absolute;inset:0;
      background:linear-gradient(135deg,rgba(255,255,255,.2) 0%,transparent 60%);
      pointer-events:none;
    }
    #bsub:hover:not(:disabled){
      box-shadow:
        inset 0 1.5px 0 rgba(255,255,255,.5),
        0 12px 40px rgba(94,234,212,.4),
        0 2px 8px rgba(0,0,0,.2);
      transform:translateY(-1px);
    }
    #bsub:active:not(:disabled){transform:scale(.98)}
    #bsub:disabled{
      background:rgba(30,41,59,.6);
      border-color:rgba(255,255,255,.05);
      color:#475569;cursor:not-allowed;
      box-shadow:none;
    }
    .bspin{
      display:inline-block;width:13px;height:13px;
      border:2px solid rgba(10,22,40,.2);
      border-top-color:#0a1628;
      border-radius:50%;
      animation:spin .65s linear infinite;
      vertical-align:middle;margin-right:7px;
    }

    #bres{
      margin-top:13px;padding:12px 16px;
      border-radius:12px;
      font-family:'Outfit',sans-serif;font-size:13px;
      display:none;text-align:center;line-height:1.5;
      -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
    }
    #bres.ok{background:rgba(94,234,212,.06);border:1px solid rgba(94,234,212,.18);color:#5eead4}
    #bres.err{background:rgba(248,113,113,.06);border:1px solid rgba(248,113,113,.18);color:#f87171}
  </style>
</head>
<body class="bg-[#0f172a] text-[#94a3b8] antialiased">

  <div id="spotlight" class="pointer-events-none fixed inset-0 z-30 opacity-0 transition-opacity duration-500"
       style="background:radial-gradient(600px circle at var(--mx,50%) var(--my,50%),rgba(29,78,216,.07),transparent 80%)"></div>

  <!-- ====== BOT (fixed bottom-right) ====== -->
  <div id="bot-wrap">
    <div id="bot-bubble"><span id="bot-msg"></span></div>
    <div id="bot-widget">
      <svg viewBox="0 0 64 84" xmlns="http://www.w3.org/2000/svg" width="68" height="68">
        <defs>
          <radialGradient id="hg" cx="40%" cy="30%"><stop offset="0%" stop-color="#1e3a5f"/><stop offset="100%" stop-color="#0f172a"/></radialGradient>
          <filter id="gl" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur in="SourceGraphic" stdDeviation="1.8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <line x1="32" y1="1" x2="32" y2="14" stroke="#5eead4" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="32" cy="1" r="4.5" fill="#5eead4" filter="url(#gl)" class="ant-p"/>
        <circle cx="32" cy="1" r="2" fill="white" opacity=".8"/>
        <rect x="8" y="13" width="48" height="34" rx="12" fill="url(#hg)" stroke="#5eead4" stroke-width="1.5"/>
        <circle cx="22" cy="29" r="7.5" fill="#020617"/><circle cx="42" cy="29" r="7.5" fill="#020617"/>
        <circle cx="22" cy="29" r="5.5" fill="#0f172a" stroke="#5eead4" stroke-width="1"/>
        <circle cx="42" cy="29" r="5.5" fill="#0f172a" stroke="#5eead4" stroke-width="1"/>
        <circle cx="22" cy="29" r="3.5" fill="#5eead4" filter="url(#gl)" class="eye-l"/>
        <circle cx="42" cy="29" r="3.5" fill="#5eead4" filter="url(#gl)" class="eye-r"/>
        <circle cx="24" cy="27" r="1.3" fill="white" opacity=".65"/><circle cx="44" cy="27" r="1.3" fill="white" opacity=".65"/>
        <path d="M18 40 Q32 50 46 40" fill="none" stroke="#5eead4" stroke-width="2" stroke-linecap="round" filter="url(#gl)"/>
        <rect x="12" y="49" width="40" height="24" rx="8" fill="url(#hg)" stroke="#5eead4" stroke-width="1.5"/>
        <circle cx="32" cy="61" r="6" fill="#5eead4" opacity=".15" class="ch-r"/>
        <circle cx="32" cy="61" r="4" fill="#5eead4" filter="url(#gl)" class="ch-c"/>
        <rect x="1" y="53" width="9" height="5" rx="2.5" fill="#0f172a" stroke="#5eead4" stroke-width="1.5"/>
        <rect x="54" y="53" width="9" height="5" rx="2.5" fill="#0f172a" stroke="#5eead4" stroke-width="1.5"/>
        <rect x="16" y="74" width="10" height="8" rx="3" fill="#0f172a" stroke="#5eead4" stroke-width="1.5"/>
        <rect x="38" y="74" width="10" height="8" rx="3" fill="#0f172a" stroke="#5eead4" stroke-width="1.5"/>
      </svg>
    </div>
  </div>

  <!-- ====== CONTACT MODAL — LIQUID GLASS ====== -->
  <div id="bot-modal">
    <div id="bot-mi">

      <div id="bot-mh">
        <button id="bcl" aria-label="Close">&times;</button>
        <div class="mh-badge">
          <span class="mh-badge-dot"></span>
          <span data-i18n="badge.available">Disponible ahora</span>
        </div>
        <h3 id="bmt">&#x00A1;Hablemos!</h3>
        <p id="bms">Cu&#xe9;ntame sobre tu proyecto y te respondo pronto.</p>
      </div>

      <div id="bot-mb">
        <form id="bot-form" novalidate>

          <div class="brow">
            <div class="bf">
              <label class="bl" for="bn" id="lbn">Nombre *</label>
              <div class="bi-wrap">
                <i class="fa-solid fa-user bi-icon"></i>
                <input id="bn" type="text" autocomplete="name" class="bi" placeholder="Tu nombre"/>
              </div>
              <span class="be" id="ebn"></span>
            </div>
            <div class="bf">
              <label class="bl" for="bph" id="lbph">Tel&#xe9;fono</label>
              <div class="bi-wrap">
                <i class="fa-solid fa-phone bi-icon"></i>
                <input id="bph" type="tel" autocomplete="tel" class="bi" placeholder="+57 300 000 0000"/>
              </div>
              <span class="be" id="ebph"></span>
            </div>
          </div>

          <div class="bf">
            <label class="bl" for="be2" id="lbe">Email *</label>
            <div class="bi-wrap">
              <i class="fa-solid fa-envelope bi-icon"></i>
              <input id="be2" type="email" autocomplete="email" class="bi" placeholder="tu@email.com"/>
            </div>
            <span class="be" id="ebe"></span>
          </div>

          <div class="bf">
            <label class="bl" for="bsj" id="lbsj">Asunto *</label>
            <div class="bi-wrap">
              <i class="fa-solid fa-tag bi-icon"></i>
              <input id="bsj" type="text" class="bi" placeholder="&#xBF;De qu&#xe9; trata tu proyecto?"/>
            </div>
            <span class="be" id="ebsj"></span>
          </div>

          <div class="bf">
            <label class="bl" for="bmsg" id="lbmsg">Mensaje *</label>
            <div class="bi-wrap">
              <i class="fa-solid fa-comment-dots bi-icon" style="top:14px;transform:none"></i>
              <textarea id="bmsg" rows="4" class="bi" placeholder="Cu&#xe9;ntame los detalles..."></textarea>
            </div>
            <span class="be" id="ebmsg"></span>
          </div>

          <div class="bdiv"></div>
          <button type="submit" id="bsub">Enviar mensaje</button>
          <div id="bres"></div>

        </form>
      </div>
    </div>
  </div>

  <!-- ====== MAIN LAYOUT ====== -->
  <div class="mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-20 lg:px-24 lg:py-0">
    <div class="lg:flex lg:justify-between lg:gap-4">

      <header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:py-24">
        <div>
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[#e2e8f0]" style="font-family:'Outfit',sans-serif"><a href="/">Luis Orozco</a></h1>
          <h2 class="mt-3 text-lg font-medium tracking-tight text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="hero.title">AI & Automation Developer</h2>
          <p class="mt-4 max-w-xs leading-normal text-[#94a3b8]" data-i18n="hero.subtitle">Construyo soluciones de hiperautomatizacion, full-stack e inteligencia artificial.</p>
          <button onclick="window.toggleLang()" aria-label="Toggle language" class="mt-6 inline-flex items-center gap-2 px-3 py-1.5 border border-[#475569] text-[#94a3b8] hover:border-[#e2e8f0] hover:text-[#e2e8f0] text-xs font-bold uppercase tracking-widest transition-all duration-200 rounded-sm" style="font-family:'JetBrains Mono',monospace">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg>
            <span class="lang-label">EN</span>
          </button>
          <nav class="nav hidden lg:block mt-10">
            <ul class="w-max">
              <li><a class="group flex items-center py-3" href="#about"><span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.about">Sobre mi</span></a></li>
              <li><a class="group flex items-center py-3" href="#experience"><span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.experience">Experiencia</span></a></li>
              <li><a class="group flex items-center py-3" href="#projects"><span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.projects">Proyectos</span></a></li>
              <li><a class="group flex items-center py-3" href="#stack"><span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.stack">Stack</span></a></li>
            </ul>
          </nav>
        </div>
        <ul class="ml-1 mt-8 flex items-center gap-5">
          <li><a class="block text-[#94a3b8] hover:text-[#e2e8f0] transition-colors" href="https://github.com/Luisr26" target="_blank" rel="noopener"><i class="fa-brands fa-github text-xl"></i></a></li>
