---
// Code Showcase Section - Automatic Typing Effect
---

<section id="codigo" class="relative py-32 bg-gray-950 overflow-hidden">
  
  <!-- Grid de fondo minimalista -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#374151_1px,transparent_1px),linear-gradient(to_bottom,#374151_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-20"></div>
  </div>

  <!-- Contenedor Principal -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Header -->
    <div class="mb-20 text-center">
      <div class="inline-flex items-center gap-2.5 px-4 py-2 bg-white text-gray-950 text-xs font-semibold tracking-widest rounded-sm mb-6" data-i18n="code.tag">
        CÓDIGO EN ACCIÓN
      </div>
      <h2 class="text-6xl sm:text-7xl lg:text-8xl font-bold text-white tracking-tight leading-[0.95] mb-6">
        Code Showcase
      </h2>
      <div class="flex items-center justify-center gap-4">
        <div class="w-20 h-0.5 bg-white"></div>
        <p class="text-xl text-gray-400 font-light tracking-wide max-w-2xl" data-i18n="code.subtitle">
          Ejemplos de código en diferentes lenguajes que domino
        </p>
      </div>
    </div>

    <!-- Language Selector -->
    <div class="mb-8 flex flex-wrap justify-center gap-3">
      <button data-lang="javascript" class="language-btn active px-6 py-3 border-2 border-white bg-white text-gray-950 font-bold uppercase text-xs tracking-widest hover:bg-gray-200 transition-all duration-300">
        JavaScript
      </button>
      <button data-lang="typescript" class="language-btn px-6 py-3 border-2 border-white bg-gray-950 text-white font-bold uppercase text-xs tracking-widest hover:bg-white hover:text-gray-950 transition-all duration-300">
        TypeScript
      </button>
      <button data-lang="python" class="language-btn px-6 py-3 border-2 border-white bg-gray-950 text-white font-bold uppercase text-xs tracking-widest hover:bg-white hover:text-gray-950 transition-all duration-300">
        Python
      </button>
      <button data-lang="java" class="language-btn px-6 py-3 border-2 border-white bg-gray-950 text-white font-bold uppercase text-xs tracking-widest hover:bg-white hover:text-gray-950 transition-all duration-300">
        Java
      </button>
      <button data-lang="vue" class="language-btn px-6 py-3 border-2 border-white bg-gray-950 text-white font-bold uppercase text-xs tracking-widest hover:bg-white hover:text-gray-950 transition-all duration-300">
        Vue
      </button>
      <button data-lang="angular" class="language-btn px-6 py-3 border-2 border-white bg-gray-950 text-white font-bold uppercase text-xs tracking-widest hover:bg-white hover:text-gray-950 transition-all duration-300">
        Angular
      </button>
    </div>

    <!-- Code Display -->
    <div class="border-2 border-white bg-gray-900 overflow-hidden">
      <!-- Terminal Header -->
      <div class="border-b-2 border-white px-6 py-4 flex items-center gap-3 bg-gray-950">
        <div class="flex gap-2">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
        </div>
        <span id="current-language" class="text-white text-sm font-mono uppercase tracking-wider">JavaScript</span>
      </div>
      
      <!-- Code Area -->
      <div class="p-8">
        <pre class="text-white font-mono text-sm sm:text-base overflow-x-auto"><code id="code-display" class="language-javascript">// Iniciando...</code></pre>
        <div id="cursor" class="inline-block w-2 h-5 bg-white ml-1 animate-pulse"></div>
      </div>
    </div>

  </div>
</section>

<script lang="ts">
  // Code examples for different languages
  const codeExamples: Record<string, string> = {
    javascript: `// API REST con Express.js y validación
const express = require('express');
const app = express();

app.use(express.json());

// Middleware de autenticación
const authMiddleware = (req, res, next) => {
  const token = req.headers.authorization;
  if (!token) {
    return res.status(401).json({ error: 'No autorizado' });
  }
  next();
};

// Endpoint para crear usuarios
app.post('/api/users', authMiddleware, async (req, res) => {
  try {
    const { name, email } = req.body;
    
    // Validación
    if (!name || !email) {
      return res.status(400).json({ 
        error: 'Datos incompletos' 
      });
    }
    
    // Crear usuario en DB
    const user = await User.create({ name, email });
    
    res.status(201).json({ 
      success: true, 
      user 
    });
  } catch (error) {
    res.status(500).json({ 
      error: error.message 
    });
  }
});

app.listen(3000, () => {
  console.log('🚀 Server running on port 3000');
});`,

    typescript: `// Sistema de notificaciones con TypeScript
interface Notification {
  id: string;
  type: 'info' | 'warning' | 'error' | 'success';
  message: string;
  timestamp: Date;
  read: boolean;
}

class NotificationService {
  private notifications: Notification[] = [];
  private subscribers: Set<(n: Notification) => void> = new Set();

  public subscribe(callback: (n: Notification) => void): void {
    this.subscribers.add(callback);
  }

  public unsubscribe(callback: (n: Notification) => void): void {
    this.subscribers.delete(callback);
  }

  public notify(
    type: Notification['type'], 
    message: string
  ): void {
    const notification: Notification = {
      id: crypto.randomUUID(),
      type,
      message,
      timestamp: new Date(),
      read: false,
    };

    this.notifications.push(notification);
    
    // Notificar a todos los suscriptores
    this.subscribers.forEach(callback => {
      callback(notification);
    });
  }

  public markAsRead(id: string): void {
    const notification = this.notifications.find(n => n.id === id);
    if (notification) {
      notification.read = true;
    }
  }

  public getUnreadCount(): number {
    return this.notifications.filter(n => !n.read).length;
  }
}

// Uso
const notificationService = new NotificationService();
notificationService.subscribe((n) => {
  console.log(\`Nueva notificación: \${n.message}\`);
});`,

    python: `# Análisis de datos con Pandas y visualización
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from datetime import datetime, timedelta

class SalesAnalyzer:
    def __init__(self, data_path: str):
        self.df = pd.read_csv(data_path)
        self.df['date'] = pd.to_datetime(self.df['date'])
        
    def clean_data(self):
        """Limpieza y preparación de datos"""
        # Eliminar duplicados
        self.df = self.df.drop_duplicates()
        
        # Rellenar valores nulos
        self.df['amount'].fillna(
            self.df['amount'].median(), 
            inplace=True
        )
        
        # Crear columnas calculadas
        self.df['year'] = self.df['date'].dt.year
        self.df['month'] = self.df['date'].dt.month
        self.df['day_of_week'] = self.df['date'].dt.day_name()
        
    def get_monthly_sales(self) -> pd.DataFrame:
        """Obtener ventas mensuales agregadas"""
        return self.df.groupby(['year', 'month']).agg({
            'amount': ['sum', 'mean', 'count'],
            'customer_id': 'nunique'
        }).round(2)
    
    def plot_trends(self):
        """Visualizar tendencias de ventas"""
        monthly_sales = self.get_monthly_sales()
        
        fig, axes = plt.subplots(2, 1, figsize=(12, 8))
        
        monthly_sales['amount']['sum'].plot(
            ax=axes[0], kind='line', marker='o',
            color='#3b82f6', linewidth=2
        )
        axes[0].set_title('Ventas Mensuales', fontsize=14)
        axes[0].grid(True, alpha=0.3)
        
        monthly_sales['amount']['count'].plot(
            ax=axes[1], kind='bar', color='#10b981'
        )
        axes[1].set_title('Transacciones por Mes', fontsize=14)
        
        plt.tight_layout()
        plt.savefig('sales_analysis.png', dpi=300)
        print("✅ Análisis completado y guardado")

analyzer = SalesAnalyzer('sales_data.csv')
analyzer.clean_data()
analyzer.plot_trends()`,

    java: `// Sistema de gestión de tareas con Spring Boot
package com.luisdev.taskmanager;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.mapping.Document;
import org.springframework.data.mongodb.repository.MongoRepository;
import org.springframework.web.bind.annotation.*;
import lombok.Data;
import java.time.LocalDateTime;
import java.util.List;
import java.util.Optional;

@SpringBootApplication
public class TaskManagerApplication {
    public static void main(String[] args) {
        SpringApplication.run(TaskManagerApplication.class, args);
    }
}

@Data
@Document(collection = "tasks")
class Task {
    @Id
    private String id;
    private String title;
    private String description;
    private TaskStatus status;
    private LocalDateTime createdAt;
    private LocalDateTime dueDate;
    
    public enum TaskStatus {
        PENDING, IN_PROGRESS, COMPLETED, CANCELLED
    }
}

interface TaskRepository extends MongoRepository<Task, String> {
    List<Task> findByStatus(Task.TaskStatus status);
}

@RestController
@RequestMapping("/api/tasks")
@CrossOrigin(origins = "*")
class TaskController {
    
    private final TaskRepository taskRepository;
    
    public TaskController(TaskRepository taskRepository) {
        this.taskRepository = taskRepository;
    }
    
    @GetMapping
    public List<Task> getAllTasks() {
        return taskRepository.findAll();
    }
    
    @PostMapping
    public Task createTask(@RequestBody Task task) {
        task.setCreatedAt(LocalDateTime.now());
        task.setStatus(Task.TaskStatus.PENDING);
        return taskRepository.save(task);
    }
}`,

