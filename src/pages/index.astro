  function _apply(lang){document.documentElement.lang=lang;localStorage.setItem('portfolio-lang',lang);document.querySelectorAll('[data-i18n]').forEach(function(el){var k=el.getAttribute('data-i18n');if(i18n[lang]&&i18n[lang][k]!==undefined)el.textContent=i18n[lang][k];});document.querySelectorAll('[data-i18n-html]').forEach(function(el){var k=el.getAttribute('data-i18n-html');if(i18n[lang]&&i18n[lang][k]!==undefined)el.innerHTML=i18n[lang][k];});document.querySelectorAll('.lang-label').forEach(function(el){el.textContent=lang==='es'?'EN':'ES';});}
  function applyTranslations(lang){var c=document.getElementById('content'),h=document.querySelector('header');if(c)c.style.opacity='0';if(h)h.style.opacity='0';setTimeout(function(){_apply(lang);if(c)c.style.opacity='1';if(h)h.style.opacity='1';},120);}
  function toggleLang(){applyTranslations(localStorage.getItem('portfolio-lang')==='en'?'es':'en');}
  window.toggleLang=toggleLang;
  document.addEventListener('DOMContentLoaded',function(){var s=localStorage.getItem('portfolio-lang')||'es';_apply(s);var c=document.getElementById('content'),h=document.querySelector('header');if(c)c.style.transition='opacity .12s ease';if(h)h.style.transition='opacity .12s ease';});
  </script>

