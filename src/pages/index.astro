---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="description" content="Luis Orozco - AI & Automation Developer."/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <title>Luis Orozco | AI & Automation Developer</title>
  <style>
    .i18n-fade{transition:opacity .15s ease}
    @keyframes botFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
    @keyframes antPulse{0%,100%{opacity:1}50%{opacity:.25}}
    @keyframes eyePulse{0%,80%,100%{transform:scaleY(1)}88%{transform:scaleY(.1)}95%{transform:scaleY(1)}}
    @keyframes chestPulse{0%,100%{opacity:.9}50%{opacity:.35}}
    @keyframes chestRipple{0%{transform:scale(1);opacity:.25}100%{transform:scale(2.8);opacity:0}}
    @keyframes bubbleIn{from{opacity:0;transform:translateY(8px) translateX(-50%)}to{opacity:1;transform:translateY(0) translateX(-50%)}}
    @keyframes bubbleOut{from{opacity:1;transform:translateY(0) translateX(-50%)}to{opacity:0;transform:translateY(-8px) translateX(-50%)}}
    @keyframes mIn{from{opacity:0;transform:scale(.93) translateY(18px)}to{opacity:1;transform:scale(1) translateY(0)}}
    #bot-wrap{position:fixed;bottom:100px;left:20px;z-index:9990;display:flex;flex-direction:column;align-items:center}
    #bot-widget{cursor:pointer;width:72px;height:72px;animation:botFloat 2.8s ease-in-out infinite;filter:drop-shadow(0 4px 16px rgba(94,234,212,.35));transition:filter .3s}
    #bot-widget:hover{filter:drop-shadow(0 4px 28px rgba(94,234,212,.65))}
    .ant-p{animation:antPulse 1.5s ease-in-out infinite}
    .eye-l{transform-origin:center;transform-box:fill-box;animation:eyePulse 5s ease-in-out infinite}
    .eye-r{transform-origin:center;transform-box:fill-box;animation:eyePulse 5s ease-in-out infinite .2s}
    .ch-c{animation:chestPulse 2s ease-in-out infinite}
    .ch-r{transform-origin:center;transform-box:fill-box;animation:chestRipple 2s ease-out infinite}
    #bot-bubble{position:absolute;bottom:calc(100% + 12px);left:50%;transform:translateX(-50%);background:#1e293b;border:1.5px solid #5eead4;border-radius:12px;padding:10px 14px;width:200px;text-align:center;font-size:12px;color:#e2e8f0;font-family:'Outfit',sans-serif;line-height:1.45;pointer-events:none;box-shadow:0 0 20px rgba(94,234,212,.15);opacity:0}
    #bot-bubble.show{animation:bubbleIn .4s ease forwards;opacity:1}
    #bot-bubble.hide{animation:bubbleOut .4s ease forwards}
    .bba{position:absolute;bottom:-7px;left:50%;width:12px;height:12px;background:#1e293b;border-right:1.5px solid #5eead4;border-bottom:1.5px solid #5eead4;transform:translateX(-50%) rotate(45deg)}
    #bot-modal{display:none;position:fixed;inset:0;z-index:10000;background:rgba(15,23,42,.88);backdrop-filter:blur(8px);align-items:center;justify-content:center;padding:20px}
    #bot-modal.open{display:flex}
    #bot-mi{background:#0f172a;border:1.5px solid #334155;border-radius:16px;padding:32px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;position:relative;box-shadow:0 25px 50px rgba(0,0,0,.6);animation:mIn .3s ease}
    .bi{width:100%;box-sizing:border-box;background:#1e293b;border:1.5px solid #334155;border-radius:8px;padding:10px 14px;font-family:'Outfit',sans-serif;font-size:14px;color:#e2e8f0;outline:none;transition:border-color .2s}
    .bi:focus{border-color:#5eead4}
    .bi::placeholder{color:#475569}
    .bl{display:block;font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#64748b;margin-bottom:6px}
    .bf{margin-bottom:16px}
    .be{display:none;font-size:11px;color:#f87171;margin-top:4px;font-family:'Outfit',sans-serif}
    #bsub{width:100%;padding:13px;background:#5eead4;color:#0f172a;font-family:'Outfit',sans-serif;font-size:14px;font-weight:700;border:none;border-radius:8px;cursor:pointer;transition:background .2s,transform .1s;text-transform:uppercase;letter-spacing:.08em;margin-top:8px}
    #bsub:hover{background:#99f6e4}
    #bsub:active{transform:scale(.98)}
    #bsub:disabled{background:#334155;color:#64748b;cursor:not-allowed}
    #bcl{position:absolute;top:14px;right:16px;background:none;border:none;color:#475569;font-size:26px;cursor:pointer;line-height:1;padding:0 4px;transition:color .2s}
    #bcl:hover{color:#e2e8f0}
    #bres{margin-top:14px;padding:12px 16px;border-radius:8px;font-family:'Outfit',sans-serif;font-size:13px;display:none;text-align:center}
    #bres.ok{background:rgba(94,234,212,.08);border:1px solid #5eead4;color:#5eead4}
    #bres.err{background:rgba(248,113,113,.08);border:1px solid #f87171;color:#f87171}
    @media(max-width:640px){#bot-widget{width:58px;height:58px}#bot-bubble{width:160px;font-size:11px}}
  </style>
</head>
<body class="bg-[#0f172a] text-[#94a3b8] antialiased">

  <div id="spotlight" class="pointer-events-none fixed inset-0 z-30 opacity-0 transition-opacity duration-500"
       style="background:radial-gradient(600px circle at var(--mx,50%) var(--my,50%),rgba(29,78,216,.07),transparent 80%)"></div>

  <!-- ====== FLOATING BOT ====== -->
  <div id="bot-wrap">
    <div id="bot-bubble"><span id="bot-msg"></span><div class="bba"></div></div>
    <div id="bot-widget">
      <svg viewBox="0 0 64 84" xmlns="http://www.w3.org/2000/svg" width="72" height="72">
        <defs>
          <radialGradient id="hg" cx="40%" cy="30%"><stop offset="0%" stop-color="#1e3a5f"/><stop offset="100%" stop-color="#0f172a"/></radialGradient>
          <filter id="gl" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur in="SourceGraphic" stdDeviation="1.8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <line x1="32" y1="1" x2="32" y2="14" stroke="#5eead4" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="32" cy="1" r="4.5" fill="#5eead4" filter="url(#gl)" class="ant-p"/>
        <circle cx="32" cy="1" r="2" fill="white" opacity=".8"/>
        <rect x="8" y="13" width="48" height="34" rx="12" fill="url(#hg)" stroke="#5eead4" stroke-width="1.5"/>
        <circle cx="22" cy="29" r="7.5" fill="#020617"/>
        <circle cx="42" cy="29" r="7.5" fill="#020617"/>
        <circle cx="22" cy="29" r="5.5" fill="#0f172a" stroke="#5eead4" stroke-width="1"/>
        <circle cx="42" cy="29" r="5.5" fill="#0f172a" stroke="#5eead4" stroke-width="1"/>
        <circle cx="22" cy="29" r="3.5" fill="#5eead4" filter="url(#gl)" class="eye-l"/>
        <circle cx="42" cy="29" r="3.5" fill="#5eead4" filter="url(#gl)" class="eye-r"/>
        <circle cx="24" cy="27" r="1.3" fill="white" opacity=".65"/>
        <circle cx="44" cy="27" r="1.3" fill="white" opacity=".65"/>
        <path d="M18 40 Q32 50 46 40" fill="none" stroke="#5eead4" stroke-width="2" stroke-linecap="round" filter="url(#gl)"/>
        <rect x="12" y="49" width="40" height="24" rx="8" fill="url(#hg)" stroke="#5eead4" stroke-width="1.5"/>
        <circle cx="32" cy="61" r="6" fill="#5eead4" opacity=".15" class="ch-r"/>
        <circle cx="32" cy="61" r="4" fill="#5eead4" filter="url(#gl)" class="ch-c"/>
        <rect x="1" y="53" width="9" height="5" rx="2.5" fill="#0f172a" stroke="#5eead4" stroke-width="1.5"/>
        <rect x="54" y="53" width="9" height="5" rx="2.5" fill="#0f172a" stroke="#5eead4" stroke-width="1.5"/>
        <rect x="16" y="74" width="10" height="8" rx="3" fill="#0f172a" stroke="#5eead4" stroke-width="1.5"/>
        <rect x="38" y="74" width="10" height="8" rx="3" fill="#0f172a" stroke="#5eead4" stroke-width="1.5"/>
      </svg>
    </div>
  </div>

  <!-- ====== CONTACT MODAL ====== -->
  <div id="bot-modal">
    <div id="bot-mi">
      <button id="bcl">&times;</button>
      <div style="margin-bottom:24px">
        <h3 id="bmt" style="font-family:'Outfit',sans-serif;font-size:22px;font-weight:700;color:#e2e8f0;margin:0 0 6px">&#x00A1;Hablemos!</h3>
        <p id="bms" style="font-family:'Outfit',sans-serif;font-size:13px;color:#64748b;margin:0">Cu&#xe9;ntame sobre tu proyecto.</p>
      </div>
      <form id="bot-form" novalidate>
        <div class="bf"><label class="bl" for="bn" id="lbn">Nombre *</label><input id="bn" type="text" autocomplete="name" class="bi" placeholder="Tu nombre"/><span class="be" id="ebn"></span></div>
        <div class="bf"><label class="bl" for="be2" id="lbe">Email *</label><input id="be2" type="email" autocomplete="email" class="bi" placeholder="tu@email.com"/><span class="be" id="ebe"></span></div>
        <div class="bf"><label class="bl" for="bph" id="lbph">Tel&#xe9;fono</label><input id="bph" type="tel" autocomplete="tel" class="bi" placeholder="+57 300 000 0000"/><span class="be" id="ebph"></span></div>
        <div class="bf"><label class="bl" for="bsj" id="lbsj">Asunto *</label><input id="bsj" type="text" class="bi" placeholder="&#xBF;De qu&#xe9; se trata?"/><span class="be" id="ebsj"></span></div>
        <div class="bf" style="margin-bottom:20px"><label class="bl" for="bmsg" id="lbmsg">Mensaje *</label><textarea id="bmsg" rows="4" class="bi" style="resize:vertical;min-height:90px" placeholder="Cu&#xe9;ntame m&#xe1;s..."></textarea><span class="be" id="ebmsg"></span></div>
        <button type="submit" id="bsub">Enviar mensaje</button>
        <div id="bres"></div>
      </form>
    </div>
  </div>

  <!-- ====== MAIN LAYOUT ====== -->
  <div class="mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-20 lg:px-24 lg:py-0">
    <div class="lg:flex lg:justify-between lg:gap-4">

      <header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:py-24">
        <div>
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[#e2e8f0]" style="font-family:'Outfit',sans-serif"><a href="/">Luis Orozco</a></h1>
          <h2 class="mt-3 text-lg font-medium tracking-tight text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="hero.title">AI & Automation Developer</h2>
          <p class="mt-4 max-w-xs leading-normal text-[#94a3b8]" data-i18n="hero.subtitle">Construyo soluciones de hiperautomatizacion, full-stack e inteligencia artificial.</p>
          <button onclick="window.toggleLang()" aria-label="Toggle language" class="mt-6 inline-flex items-center gap-2 px-3 py-1.5 border border-[#475569] text-[#94a3b8] hover:border-[#e2e8f0] hover:text-[#e2e8f0] text-xs font-bold uppercase tracking-widest transition-all duration-200 rounded-sm" style="font-family:'JetBrains Mono',monospace">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg>
            <span class="lang-label">EN</span>
          </button>
          <nav class="nav hidden lg:block mt-10">
            <ul class="w-max">
              <li><a class="group flex items-center py-3" href="#about"><span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.about">Sobre mi</span></a></li>
              <li><a class="group flex items-center py-3" href="#experience"><span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.experience">Experiencia</span></a></li>
              <li><a class="group flex items-center py-3" href="#projects"><span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.projects">Proyectos</span></a></li>
              <li><a class="group flex items-center py-3" href="#stack"><span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.stack">Stack</span></a></li>
            </ul>
          </nav>
        </div>
        <ul class="ml-1 mt-8 flex items-center gap-5">
          <li><a class="block text-[#94a3b8] hover:text-[#e2e8f0] transition-colors" href="https://github.com/Luisr26" target="_blank" rel="noopener"><i class="fa-brands fa-github text-xl"></i></a></li>
          <li><a class="block text-[#94a3b8] hover:text-[#e2e8f0] transition-colors" href="https://www.linkedin.com/in/luis-orozco-07ab5b208/" target="_blank" rel="noopener"><i class="fa-brands fa-linkedin-in text-xl"></i></a></li>
          <li><a class="block text-[#94a3b8] hover:text-[#e2e8f0] transition-colors" href="https://wa.me/573045233125" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp text-xl"></i></a></li>
          <li><a class="block text-[#94a3b8] hover:text-[#e2e8f0] transition-colors" href="mailto:luisoro009@gmail.com"><i class="fa-solid fa-envelope text-xl"></i></a></li>
        </ul>
      </header>

      <main id="content" class="pt-24 lg:w-[52%] lg:py-24">

        <section id="about" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24">
          <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0"><h2 class="text-sm font-bold uppercase tracking-widest text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.about">Sobre mi</h2></div>
          <div>
            <p class="mb-4" data-i18n-html="about.p1">Aprendi a programar a los 15 anios por curiosidad, sin que nadie me lo pidiera. Ese mismo instinto de entender como funcionan las cosas es lo que hoy me lleva a construir sistemas de <span class="text-[#e2e8f0]">automatizacion, agentes de IA e integraciones</span> que resuelven problemas reales en lugar de solo cumplir con un requisito.</p>
            <p class="mb-4" data-i18n-html="about.p2">Me muevo comodo entre frontend y backend, pero donde realmente disfruto es en el espacio entre sistemas: conectar APIs, orquestar flujos, hacer que herramientas distintas hablen entre si. Si hay una tarea manual y repetitiva en un proceso, mi primer instinto es <span class="text-[#e2e8f0]">automatizarla</span>.</p>
            <p class="mb-4" data-i18n-html="about.p3">Estoy disponible para proyectos de <span class="text-[#e2e8f0]">automatizacion, desarrollo full-stack, integraciones de APIs y sistemas con IA</span>. Me interesa trabajar en productos que importen, con personas que quieran construir algo bien hecho desde el principio.</p>
          </div>
        </section>

        <section id="experience" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24">
          <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0"><h2 class="text-sm font-bold uppercase tracking-widest text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.experience">Experiencia</h2></div>
          <ol class="group/list">
            <li class="mb-12"><div class="group relative grid pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:!opacity-100 lg:group-hover/list:opacity-50"><div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition lg:-inset-x-6 lg:block lg:group-hover:bg-[#1e293b]/50"></div><header class="z-10 mb-2 mt-1 text-xs font-semibold uppercase tracking-wide text-[#64748b] sm:col-span-2" style="font-family:'JetBrains Mono',monospace" data-i18n="exp.bb.date">Dic 2025 — Presente</header><div class="z-10 sm:col-span-6"><h3 class="font-medium leading-snug text-[#e2e8f0]" style="font-family:'Outfit',sans-serif"><a class="inline-flex items-baseline font-medium leading-tight text-[#e2e8f0] hover:text-[#5eead4] group/link" href="#"><span data-i18n="exp.bb.title">Desarrollador IA · Blackbird Labs</span><i class="fa-solid fa-arrow-up-right-from-square inline-block ml-1.5 text-[.6rem] shrink-0 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"></i></a></h3><p class="mt-2 text-sm leading-normal" data-i18n="exp.bb.desc">Disenio e implementacion de sistemas inteligentes con modelos de lenguaje y agentes de IA. Conexion de plataformas mediante APIs REST, protocolos MCP y orquestacion. Arquitecturas escalables para productos de inteligencia artificial.</p><ul class="mt-2 flex flex-wrap"><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">AI Agents</div></li><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">MCP</div></li><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">APIs REST</div></li></ul></div></div></li>
            <li class="mb-12"><div class="group relative grid pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:!opacity-100 lg:group-hover/list:opacity-50"><div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition lg:-inset-x-6 lg:block lg:group-hover:bg-[#1e293b]/50"></div><header class="z-10 mb-2 mt-1 text-xs font-semibold uppercase tracking-wide text-[#64748b] sm:col-span-2" style="font-family:'JetBrains Mono',monospace" data-i18n="exp.ret.date">Ene 2026 — Presente</header><div class="z-10 sm:col-span-6"><h3 class="font-medium leading-snug text-[#e2e8f0]" style="font-family:'Outfit',sans-serif"><a class="inline-flex items-baseline font-medium leading-tight text-[#e2e8f0] hover:text-[#5eead4] group/link" href="#"><span data-i18n="exp.ret.title">Desarrollador IA · Retycol</span><i class="fa-solid fa-arrow-up-right-from-square inline-block ml-1.5 text-[.6rem] shrink-0 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"></i></a></h3><p class="mt-2 text-sm leading-normal" data-i18n="exp.ret.desc">Ecosistema de automatizacion hibrido con n8n (84+ nodos) y Power Automate, integrando Microsoft Graph API, ClickUp y SheetJS. Verificacion documental farmaceutica con Google Gemini. Dashboards operativos con reportes HTML y KPIs.</p><ul class="mt-2 flex flex-wrap"><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">n8n</div></li><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Power Automate</div></li><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Gemini</div></li><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Angular</div></li></ul></div></div></li>
