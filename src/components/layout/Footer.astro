---
import { SITE } from '../../config/site';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import SplitText from '../ui/SplitText.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <a class="big sign" href="#contacto" data-prox data-cursor={t('nav.contact')}>
    <SplitText text={t('footer.cta')} />
  </a>
  <div class="row mono">
    <div class="col">
      <span class="muted">{t('footer.time')}</span>
      <span><time data-clock data-tz={SITE.timeZone} data-locale={lang === 'es' ? 'es-CO' : 'en-US'}>--:--</time> · GMT−5</span>
    </div>
    <div class="col">
      <span class="muted">{t('footer.social')}</span>
      <span class="links">
        <a href={SITE.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={SITE.social.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href={`mailto:${SITE.email}`}>Email</a>
      </span>
    </div>
    <div class="col">
      <span class="muted">© {year}</span>
      <span>{t('footer.built')}</span>
    </div>
    <button class="totop mag" type="button" data-totop data-cursor="↑" aria-label={t('footer.top')}>↑</button>
  </div>
</footer>

<style>
  .footer {
    padding: 64px var(--pad) 40px;
    display: grid;
    gap: 48px;
  }
  .big {
    font-size: clamp(64px, 15.5vw, 290px);
    text-decoration: none;
    display: block;
    user-select: none;
    width: fit-content;
  }
  @supports (animation-timeline: view()) {
    .big {
      animation: widen linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 50%;
    }
  }
  @keyframes widen {
    from {
      font-variation-settings: 'wdth' 62, 'wght' 300;
      letter-spacing: -0.04em;
    }
    to {
      font-variation-settings: 'wdth' 62, 'wght' 900;
      letter-spacing: -0.01em;
    }
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, 1fr) auto;
    gap: 24px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
    align-items: start;
  }
  .col {
    display: grid;
    gap: 6px;
    line-height: 1.6;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .links a {
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }
  .totop {
    background: none;
    border: 1px solid var(--line);
    color: var(--ink);
    border-radius: 999px;
    width: 56px;
    height: 56px;
    cursor: pointer;
    font-size: 20px;
  }
  @media (max-width: 820px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
