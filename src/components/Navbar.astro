---
const lk=[{n:'01',l:'Sobre m\u00ed',h:'#about'},{n:'02',l:'Experiencia',h:'#exp'},{n:'03',l:'Proyectos',h:'#projects'},{n:'04',l:'Stack',h:'#stack'},{n:'05',l:'Contacto',h:'#contact'}];
---
<nav id="nav" class="fixed top-0 inset-x-0 z-50 bg-[#060611]/80 backdrop-blur-2xl border-b border-white/[.04] transition-transform duration-300">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">
    <a href="#" class="text-[#64ffda] text-sm font-medium" style="font-family:'JetBrains Mono',monospace">&lt;LO/&gt;</a>
    <ul class="hidden md:flex items-center gap-6">
      {lk.map(({n,l,h})=>(
        <li><a href={h} class="text-xs text-[#94a3b8] hover:text-[#64ffda] transition-colors" style="font-family:'JetBrains Mono',monospace"><span class="text-[#64ffda] mr-1">{n}.</span>{l}</a></li>
      ))}
    </ul>
    <a href="#contact" class="hidden md:block btn !text-xs !px-4 !py-2">Hablemos</a>
    <button id="mb" class="md:hidden text-[#e2e8f0] text-xl"><i class="fa-solid fa-bars"></i></button>
  </div>
</nav>
<div id="mo" class="fixed inset-0 bg-black/60 z-[190] hidden md:hidden"></div>
<div id="mm" class="fixed top-0 right-0 w-[72vw] max-w-xs h-screen bg-[#0c0c1d]/95 backdrop-blur-2xl z-[200] flex flex-col items-center justify-center gap-7 translate-x-full transition-transform duration-300 md:hidden">
  {lk.map(({n,l,h})=>(
    <a href={h} class="ml text-[#e2e8f0] hover:text-[#64ffda]" style="font-family:'JetBrains Mono',monospace"><span class="text-[#64ffda]">{n}.</span> {l}</a>
  ))}
  <a href="#contact" class="btn">Hablemos</a>
</div>