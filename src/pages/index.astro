  <!-- NAV + SPOTLIGHT -->
  <script>
    var sl=document.getElementById('spotlight');
    document.addEventListener('mousemove',function(e){
      sl.style.setProperty('--mx',e.clientX+'px');
      sl.style.setProperty('--my',e.clientY+'px');
      sl.style.opacity='1';
    });
    var sections=document.querySelectorAll('section[id]');
    var navLinks=document.querySelectorAll('.nav a');
    function updateNav(){
      var sy=window.scrollY+200;
      sections.forEach(function(sec){
        var top=sec.offsetTop,h=sec.offsetHeight,id=sec.getAttribute('id');
        if(sy>=top&&sy<top+h){
          navLinks.forEach(function(link){
            var active=link.getAttribute('href')==='#'+id;
            var ind=link.querySelector('.nav-indicator');
            var txt=link.querySelector('.nav-text');
            if(active){ind.style.width='4rem';ind.style.backgroundColor='#e2e8f0';txt.style.color='#e2e8f0';}
            else{ind.style.width='2rem';ind.style.backgroundColor='#475569';txt.style.color='#475569';}
          });
        }
      });
    }
    window.addEventListener('scroll',updateNav);
    updateNav();
  </script>
