---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="description" content="Luis Orozco - AI & Automation Developer. Angular, Spring Boot, n8n, Python."/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <title>Luis Orozco | AI & Automation Developer</title>
  <style>
    .i18n-fade { transition: opacity 0.15s ease; }
  </style>
</head>
<body class="bg-[#0f172a] text-[#94a3b8] antialiased">

  <!-- MOUSE SPOTLIGHT -->
  <div id="spotlight" class="pointer-events-none fixed inset-0 z-30 opacity-0 transition-opacity duration-500"
       style="background:radial-gradient(600px circle at var(--mx,50%) var(--my,50%),rgba(29,78,216,.07),transparent 80%)"></div>

  <div class="mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-20 lg:px-24 lg:py-0">
    <div class="lg:flex lg:justify-between lg:gap-4">

      <!-- ========== LEFT COLUMN (STICKY) ========== -->
      <header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:py-24">
        <div>
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[#e2e8f0]" style="font-family:'Outfit',sans-serif">
            <a href="/">Luis Orozco</a>
          </h1>
          <h2 class="mt-3 text-lg font-medium tracking-tight text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="hero.title">
            AI & Automation Developer
          </h2>
          <p class="mt-4 max-w-xs leading-normal text-[#94a3b8]" data-i18n="hero.subtitle">
            Construyo soluciones de hiperautomatizacion, full-stack e inteligencia artificial.
          </p>

          <!-- LANG TOGGLE -->
          <button
            onclick="window.toggleLang()"
            aria-label="Toggle language / Cambiar idioma"
            class="mt-6 inline-flex items-center gap-2 px-3 py-1.5 border border-[#475569] text-[#94a3b8] hover:border-[#e2e8f0] hover:text-[#e2e8f0] text-xs font-bold uppercase tracking-widest transition-all duration-200 rounded-sm"
            style="font-family:'JetBrains Mono',monospace"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
            </svg>
            <span class="lang-label">EN</span>
          </button>

          <!-- NAV SPY -->
          <nav class="nav hidden lg:block mt-10" aria-label="In-page jump links">
            <ul class="w-max">
              <li><a class="group flex items-center py-3" href="#about">
                <span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span>
                <span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.about">Sobre mi</span>
              </a></li>
              <li><a class="group flex items-center py-3" href="#experience">
                <span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span>
                <span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.experience">Experiencia</span>
              </a></li>
              <li><a class="group flex items-center py-3" href="#projects">
                <span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span>
                <span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.projects">Proyectos</span>
              </a></li>
              <li><a class="group flex items-center py-3" href="#stack">
                <span class="nav-indicator mr-4 h-px w-8 bg-[#475569] transition-all group-hover:w-16 group-hover:bg-[#e2e8f0]"></span>
                <span class="nav-text text-xs font-bold uppercase tracking-widest text-[#475569] group-hover:text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.stack">Stack</span>
              </a></li>
            </ul>
          </nav>
        </div>

        <!-- SOCIAL LINKS -->
        <ul class="ml-1 mt-8 flex items-center gap-5" aria-label="Social media">
          <li><a class="block text-[#94a3b8] hover:text-[#e2e8f0] transition-colors" href="https://github.com/Luisr26" target="_blank" rel="noopener" title="GitHub"><i class="fa-brands fa-github text-xl"></i></a></li>
          <li><a class="block text-[#94a3b8] hover:text-[#e2e8f0] transition-colors" href="https://www.linkedin.com/in/luis-orozco-07ab5b208/" target="_blank" rel="noopener" title="LinkedIn"><i class="fa-brands fa-linkedin-in text-xl"></i></a></li>
          <li><a class="block text-[#94a3b8] hover:text-[#e2e8f0] transition-colors" href="https://wa.me/573045233125" target="_blank" rel="noopener" title="WhatsApp"><i class="fa-brands fa-whatsapp text-xl"></i></a></li>
          <li><a class="block text-[#94a3b8] hover:text-[#e2e8f0] transition-colors" href="mailto:luisoro009@gmail.com" title="Email"><i class="fa-solid fa-envelope text-xl"></i></a></li>
        </ul>
      </header>

      <!-- ========== RIGHT COLUMN (SCROLLABLE) ========== -->
      <main id="content" class="pt-24 lg:w-[52%] lg:py-24">

        <!-- ABOUT -->
        <section id="about" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24">
          <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
            <h2 class="text-sm font-bold uppercase tracking-widest text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.about">Sobre mi</h2>
          </div>
          <div>
            <p class="mb-4" data-i18n-html="about.p1">Aprendi a programar a los 15 anios por curiosidad, sin que nadie me lo pidiera. Ese mismo instinto de entender como funcionan las cosas es lo que hoy me lleva a construir sistemas de <span class="text-[#e2e8f0]">automatizacion, agentes de IA e integraciones</span> que resuelven problemas reales en lugar de solo cumplir con un requisito.</p>
            <p class="mb-4" data-i18n-html="about.p2">Me muevo comodo entre frontend y backend, pero donde realmente disfruto es en el espacio entre sistemas: conectar APIs, orquestar flujos, hacer que herramientas distintas hablen entre si. Si hay una tarea manual y repetitiva en un proceso, mi primer instinto es <span class="text-[#e2e8f0]">automatizarla</span>.</p>
            <p class="mb-4" data-i18n-html="about.p3">Estoy disponible para proyectos de <span class="text-[#e2e8f0]">automatizacion, desarrollo full-stack, integraciones de APIs y sistemas con IA</span>. Me interesa trabajar en productos que importen, con personas que quieran construir algo bien hecho desde el principio.</p>
          </div>
        </section>

        <!-- EXPERIENCE -->
        <section id="experience" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24">
          <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
            <h2 class="text-sm font-bold uppercase tracking-widest text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.experience">Experiencia</h2>
          </div>
          <div>
            <ol class="group/list">

              <!-- Blackbird Labs -->
              <li class="mb-12">
                <div class="group relative grid pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:!opacity-100 lg:group-hover/list:opacity-50">
                  <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-[#1e293b]/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"></div>
                  <header class="z-10 mb-2 mt-1 text-xs font-semibold uppercase tracking-wide text-[#64748b] sm:col-span-2" style="font-family:'JetBrains Mono',monospace" data-i18n="exp.bb.date">Dic 2025 — Presente</header>
                  <div class="z-10 sm:col-span-6">
                    <h3 class="font-medium leading-snug text-[#e2e8f0]" style="font-family:'Outfit',sans-serif">
                      <a class="inline-flex items-baseline font-medium leading-tight text-[#e2e8f0] hover:text-[#5eead4] focus-visible:text-[#5eead4] group/link" href="#">
                        <span data-i18n="exp.bb.title">Desarrollador IA · Blackbird Labs</span>
                        <i class="fa-solid fa-arrow-up-right-from-square inline-block ml-1.5 text-[.6rem] shrink-0 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"></i>
                      </a>
                    </h3>
                    <p class="mt-2 text-sm leading-normal" data-i18n="exp.bb.desc">Disenio e implementacion de sistemas inteligentes con modelos de lenguaje y agentes de IA. Conexion de plataformas mediante APIs REST, protocolos MCP y orquestacion. Arquitecturas escalables para productos de inteligencia artificial.</p>
                    <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">AI Agents</div></li>
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">MCP</div></li>
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">APIs REST</div></li>
                    </ul>
                  </div>
                </div>
              </li>

              <!-- Retycol -->
              <li class="mb-12">
                <div class="group relative grid pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:!opacity-100 lg:group-hover/list:opacity-50">
                  <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-[#1e293b]/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"></div>
                  <header class="z-10 mb-2 mt-1 text-xs font-semibold uppercase tracking-wide text-[#64748b] sm:col-span-2" style="font-family:'JetBrains Mono',monospace" data-i18n="exp.ret.date">Ene 2026 — Presente</header>
                  <div class="z-10 sm:col-span-6">
                    <h3 class="font-medium leading-snug text-[#e2e8f0]" style="font-family:'Outfit',sans-serif">
                      <a class="inline-flex items-baseline font-medium leading-tight text-[#e2e8f0] hover:text-[#5eead4] focus-visible:text-[#5eead4] group/link" href="#">
                        <span data-i18n="exp.ret.title">Desarrollador IA · Retycol</span>
                        <i class="fa-solid fa-arrow-up-right-from-square inline-block ml-1.5 text-[.6rem] shrink-0 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"></i>
                      </a>
                    </h3>
                    <p class="mt-2 text-sm leading-normal" data-i18n="exp.ret.desc">Ecosistema de automatizacion hibrido con n8n (84+ nodos) y Power Automate, integrando Microsoft Graph API, ClickUp y SheetJS. Verificacion documental farmaceutica con Google Gemini. Dashboards operativos con reportes HTML y KPIs. Desarrollo de SPDER: prediccion de demanda con Angular, Node.js, PostgreSQL y Python.</p>
                    <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">n8n</div></li>
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Power Automate</div></li>
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Angular</div></li>
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Gemini</div></li>
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">PostgreSQL</div></li>
                    </ul>
                  </div>
                </div>
              </li>

              <!-- ICAS -->
              <li class="mb-12">
                <div class="group relative grid pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:!opacity-100 lg:group-hover/list:opacity-50">
                  <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-[#1e293b]/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"></div>
                  <header class="z-10 mb-2 mt-1 text-xs font-semibold uppercase tracking-wide text-[#64748b] sm:col-span-2" style="font-family:'JetBrains Mono',monospace" data-i18n="exp.icas.date">Ene 2023 — Mar 2024</header>
                  <div class="z-10 sm:col-span-6">
                    <h3 class="font-medium leading-snug text-[#e2e8f0]" style="font-family:'Outfit',sans-serif">
                      <a class="inline-flex items-baseline font-medium leading-tight text-[#e2e8f0] hover:text-[#5eead4] focus-visible:text-[#5eead4] group/link" href="#">
                        <span data-i18n="exp.icas.title">Web Developer & Data Analyst · ICAS LTDA</span>
                        <i class="fa-solid fa-arrow-up-right-from-square inline-block ml-1.5 text-[.6rem] shrink-0 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"></i>
                      </a>
                    </h3>
                    <p class="mt-1 text-xs text-[#64748b]" style="font-family:'JetBrains Mono',monospace" data-i18n="exp.icas.badge">Permiso de trabajo menor de edad</p>
                    <p class="mt-2 text-sm leading-normal" data-i18n="exp.icas.desc">Dashboards interactivos para pipeline I+D farmaceutico con Node.js, Microsoft Graph API y Chart.js. Procesamiento de datos con Python (Pandas, NumPy, Matplotlib). Orquestacion de APIs REST conectando SharePoint, OneDrive y ClickUp.</p>
                    <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Node.js</div></li>
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Python</div></li>
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Graph API</div></li>
                      <li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Chart.js</div></li>
                    </ul>
                  </div>
                </div>
              </li>
            </ol>
          </div>
        </section>

        <!-- PROJECTS -->
        <section id="projects" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24">
          <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
            <h2 class="text-sm font-bold uppercase tracking-widest text-[#e2e8f0]" style="font-family:'Outfit',sans-serif" data-i18n="nav.projects">Proyectos</h2>
          </div>
          <div>
            <ul class="group/list">
              <li class="mb-12"><div class="group relative grid gap-4 pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:!opacity-100 lg:group-hover/list:opacity-50"><div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-[#1e293b]/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"></div><div class="z-10 sm:order-2 sm:col-span-6"><h3 style="font-family:'Outfit',sans-serif"><a class="inline-flex items-baseline font-medium leading-tight text-[#e2e8f0] hover:text-[#5eead4] group/link" href="https://github.com/Luisr26/CoopCredit" target="_blank" rel="noopener"><span>CoopCredit<i class="fa-solid fa-arrow-up-right-from-square inline-block ml-1.5 text-[.55rem] transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"></i></span></a></h3><p class="mt-2 text-sm leading-normal" data-i18n="proj.coopcredit.desc">Sistema integral de creditos para cooperativas. Arquitectura Hexagonal, seguridad enterprise-grade, evaluacion automatizada de riesgo y 109 tests.</p><ul class="mt-2 flex flex-wrap"><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Java 21</div></li><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Spring Boot</div></li><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">PostgreSQL</div></li><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Docker</div></li></ul></div><div class="z-10 sm:order-1 sm:col-span-2 mt-1 text-xs font-semibold uppercase tracking-wide text-[#64748b]" style="font-family:'JetBrains Mono',monospace"><i class="fa-solid fa-star text-[#5eead4] mr-1"></i><span data-i18n="proj.featured">Destacado</span></div></div></li>
              <li class="mb-12"><div class="group relative grid gap-4 pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:!opacity-100 lg:group-hover/list:opacity-50"><div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-[#1e293b]/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"></div><div class="z-10 sm:order-2 sm:col-span-6"><h3 style="font-family:'Outfit',sans-serif"><a class="inline-flex items-baseline font-medium leading-tight text-[#e2e8f0] hover:text-[#5eead4] group/link" href="https://github.com/Luisr26/NovaBook" target="_blank" rel="noopener"><span>NovaBook<i class="fa-solid fa-arrow-up-right-from-square inline-block ml-1.5 text-[.55rem] transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"></i></span></a></h3><p class="mt-2 text-sm leading-normal" data-i18n="proj.novabook.desc">Gestion de bibliotecas con GUI JavaFX, MySQL, RBAC (Admin/Bibliotecario), CRUD completo, import/export CSV. Patron MVC + DAO.</p><ul class="mt-2 flex flex-wrap"><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">Java</div></li><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">JavaFX</div></li><li class="mr-1.5 mt-2"><div class="flex items-center rounded-full bg-[#5eead4]/10 px-3 py-1 text-xs font-medium leading-5 text-[#5eead4]" style="font-family:'JetBrains Mono',monospace">MySQL</div></li></ul></div><div class="z-10 sm:order-1 sm:col-span-2 mt-1 text-xs font-semibold uppercase tracking-wide text-[#64748b]" style="font-family:'JetBrains Mono',monospace">Desktop App</div></div></li>
