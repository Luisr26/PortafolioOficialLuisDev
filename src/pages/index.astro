      es:{t:'¡Hablemos!',s:'Cuéntame sobre tu proyecto y te respondo pronto.',n:'Nombre *',e:'Email *',p:'Teléfono',sj:'Asunto *',m:'Mensaje *',btn:'Enviar mensaje',sending:'Enviando...',ok:'¡Enviado! Te respondo lo antes posible 🚀',fail:'Error al enviar. Inténtalo de nuevo.',en:'Mín. 2 caracteres',ee:'Email inválido',ep:'Teléfono inválido',es2:'Mín. 3 caracteres',em:'Mín. 10 caracteres'},
