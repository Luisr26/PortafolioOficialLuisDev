    function _doApply(lang) {
      document.documentElement.lang = lang;
      localStorage.setItem('portfolio-lang', lang);
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n');
        if (i18n[lang] && i18n[lang][key] !== undefined) {
          el.textContent = i18n[lang][key];
        }
      });
      document.querySelectorAll('[data-i18n-html]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-html');
        if (i18n[lang] && i18n[lang][key] !== undefined) {
          el.innerHTML = i18n[lang][key];
        }
      });
      document.querySelectorAll('.lang-label').forEach(function(el) {
        el.textContent = lang === 'es' ? 'EN' : 'ES';
      });
    }

    function applyTranslations(lang) {
      var el = document.getElementById('content');
      var hdr = document.querySelector('header');
      if (el) el.style.opacity = '0';
      if (hdr) hdr.style.opacity = '0';
      setTimeout(function() {
        _doApply(lang);
        if (el) el.style.opacity = '1';
        if (hdr) hdr.style.opacity = '1';
      }, 120);
    }

    function toggleLang() {
      var current = localStorage.getItem('portfolio-lang') || 'es';
      applyTranslations(current === 'es' ? 'en' : 'es');
    }

    window.toggleLang = toggleLang;

    document.addEventListener('DOMContentLoaded', function() {
      var saved = localStorage.getItem('portfolio-lang') || 'es';
      // Apply immediately without fade on initial load
      _doApply(saved);
      // Enable CSS transitions after initial render
      var el = document.getElementById('content');
      var hdr = document.querySelector('header');
      if (el) el.style.transition = 'opacity 0.12s ease';
      if (hdr) hdr.style.transition = 'opacity 0.12s ease';
    });
  </script>

