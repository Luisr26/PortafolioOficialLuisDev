---
import { Image } from 'astro:assets';
import portrait from '../../assets/images/luis-orozco.webp';
import type { Lang } from '../../i18n/ui';
import { emphasize, useTranslations } from '../../i18n/utils';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// La frase se parte en líneas para revelarlas una a una.
const statement = emphasize(t('about.statement'));
const lines = statement.split(/(?<=\.)\s+/);
const now = [
  { k: t('now.building.k'), v: t('now.building.v') },
  { k: t('now.learning.k'), v: t('now.learning.v') },
  { k: t('now.studying.k'), v: t('now.studying.v') },
];
---

<section class="section about" id="sobre" aria-labelledby="about-h">
  <SectionHead id="about-h" label={t('about.label')} aside={t('about.aside')} />

  <p class="statement">
    {lines.map((l) => <span class="line"><span set:html={l} /></span>)}
  </p>

  <div class="bio">
    <figure class="photo rv">
      <Image
        src={portrait}
        alt={t('about.photoAlt')}
        widths={[160, 240, 344]}
        sizes="(max-width: 720px) 160px, 240px"
        format="webp"
        quality={82}
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="copy rv">
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
    </div>
  </div>

  <div class="now rv">
    <div class="now-head mono"><span data-scramble>{t('now.label')}</span><span>{t('now.updated')}</span></div>
    <dl>
      {now.map((n) => <div><dt class="mono">{n.k}</dt><dd>{n.v}</dd></div>)}
    </dl>
  </div>
</section>

<style>
  .about {
    display: grid;
  }
  .statement {
    font-size: clamp(32px, 5.4vw, 88px);
    line-height: 1.04;
    font-variation-settings: 'wdth' 80, 'wght' 700;
    max-width: 18ch;
  }
  .line {
    display: block;
    overflow: hidden;
  }
  .line > span {
    display: block;
  }
  @supports (animation-timeline: view()) {
    .line > span {
      animation: line-up linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 35%;
    }
  }
  @keyframes line-up {
    from { transform: translateY(100%); }
    to { transform: none; }
  }

  .bio {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: clamp(24px, 5vw, 80px);
    align-items: end;
    margin: clamp(56px, 8vw, 112px) 0;
  }
  .photo {
    position: relative;
    width: 240px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    background: var(--surface);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.6s var(--ease), transform 0.8s var(--ease);
  }
  .photo:hover :global(img) {
    filter: none;
    transform: scale(1.04);
  }
  .copy {
    display: grid;
    gap: 18px;
    max-width: 60ch;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .now {
    border-top: 1px solid var(--ink);
  }
  .now-head {
    display: flex;
    justify-content: space-between;
    padding: 14px 0 6px;
    color: var(--ink-2);
  }
  .now dl > div {
    display: grid;
    grid-template-columns: minmax(160px, 240px) 1fr;
    gap: 24px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.4s var(--ease);
  }
  .now dt {
    color: var(--ink-2);
    transition: color 0.3s;
  }
  .now dd {
    font-size: clamp(22px, 2.6vw, 38px);
    line-height: 1.15;
    font-variation-settings: 'wdth' 85, 'wght' 600;
    max-width: 32ch;
  }
  .now dl > div:hover {
    padding-left: 16px;
  }
  .now dl > div:hover dt {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .bio {
      grid-template-columns: 1fr;
    }
    .photo {
      width: 160px;
    }
    .now dl > div {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
