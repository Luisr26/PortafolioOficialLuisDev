---
import { SITE } from '../../config/site';
import { languages, locales, type Lang } from '../../i18n/ui';
import { homePath } from '../../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Ruta absoluta de la imagen OG (en /public). */
  image?: string;
}

const { lang, title, description, image = '/og/og-default.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  hreflang: l === 'es' ? 'es-CO' : 'en-US',
  href: new URL(homePath(l), SITE.url).href,
}));

const person = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#person`,
      name: SITE.fullName,
      alternateName: SITE.name,
      url: SITE.url,
      image: new URL('/og/luis-orozco.webp', SITE.url).href,
      email: `mailto:${SITE.email}`,
      jobTitle: lang === 'es' ? 'Desarrollador de IA, Automatización y Full-Stack' : 'AI, Automation & Full-Stack Developer',
      worksFor: { '@type': 'Organization', name: SITE.worksFor.name, url: SITE.worksFor.url },
      alumniOf: SITE.alumniOf.map((name) => ({ '@type': 'EducationalOrganization', name })),
      address: {
        '@type': 'PostalAddress',
        addressLocality: SITE.location.city,
        addressCountry: SITE.location.countryCode,
      },
      knowsAbout: [
        'Hiperautomatización', 'n8n', 'Power Automate', 'Agentes de IA', 'Model Context Protocol',
        'Java', 'Spring Boot', 'Angular', 'TypeScript', 'Node.js', 'Python', 'Arquitectura Hexagonal', 'Microservicios',
      ],
      knowsLanguage: ['es', 'en'],
      sameAs: [SITE.social.github, SITE.social.linkedin],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: `${SITE.name} — Portafolio`,
      inLanguage: lang === 'es' ? 'es-CO' : 'en-US',
      publisher: { '@id': `${SITE.url}/#person` },
    },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />
<meta name="author" content={SITE.fullName} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="theme-color" content={SITE.themeColor} />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={locales[lang]} />
<meta property="og:locale:alternate" content={locales[lang === 'es' ? 'en' : 'es']} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="profile:first_name" content="Luis" />
<meta property="profile:last_name" content="Orozco" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(person)} />
