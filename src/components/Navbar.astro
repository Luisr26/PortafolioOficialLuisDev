---
const links = [
  { num: '01', label: 'Sobre mí', href: '#about' },
  { num: '02', label: 'Experiencia', href: '#experience' },
  { num: '03', label: 'Proyectos', href: '#projects' },
  { num: '04', label: 'Stack', href: '#stack' },
  { num: '05', label: 'Contacto', href: '#contact' },
];
---
<nav id="navbar" class="fixed top-0 inset-x-0 z-50 bg-dark/85 backdrop-blur-xl border-b border-white/5 transition-transform duration-300">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-[70px]">
    <a href="#" class="font-mono font-medium text-accent text-sm tracking-tight">&lt;L.O /&gt;</a>
    <ul class="hidden md:flex items-center gap-7">
      {links.map(({ num, label, href }) => (
        <li>
          <a href={href} class="font-mono text-[.8rem] text-slate hover:text-accent transition-colors tracking-wide">
            <span class="text-accent text-[.72rem] mr-1">{num}.</span>{label}
          </a>
        </li>
      ))}
    </ul>
    <a href="#contact" class="hidden md:block btn-outline !text-xs !px-4 !py-2">Contáctame</a>
    <button id="menuBtn" class="md:hidden text-slate-light text-xl" aria-label="Menu">
      <i class="fa-solid fa-bars" id="menuIcon"></i>
    </button>
  </div>
  <div id="mobileMenu" class="fixed top-0 right-0 w-[70vw] max-w-[320px] h-screen bg-dark-card/[.97] backdrop-blur-xl z-[200] flex flex-col items-center justify-center gap-8 translate-x-full transition-transform duration-300 md:hidden">
    {links.map(({ num, label, href }) => (
      <a href={href} class="mobile-link font-mono text-slate-light hover:text-accent transition-colors">
        <span class="text-accent">{num}.</span> {label}
      </a>
    ))}
    <a href="#contact" class="btn-outline">Contáctame</a>
  </div>
  <div id="overlay" class="fixed inset-0 bg-black/50 z-[190] hidden md:hidden"></div>
</nav>
<script>
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('mobileMenu');
  const overlay = document.getElementById('overlay');
  const icon = document.getElementById('menuIcon');
  function toggle() {
    menu?.classList.toggle('translate-x-full');
    menu?.classList.toggle('translate-x-0');
    overlay?.classList.toggle('hidden');
    icon?.classList.toggle('fa-bars');
    icon?.classList.toggle('fa-xmark');
  }
  btn?.addEventListener('click', toggle);
  overlay?.addEventListener('click', toggle);
  document.querySelectorAll('.mobile-link').forEach((l) => l.addEventListener('click', toggle));
</script>
