  { icon: 'fa-brands fa-linkedin-in', href: 'https://www.linkedin.com/in/luis-orozco-07ab5b208/', label: 'LinkedIn' },
  { icon: 'fa-brands fa-whatsapp', href: 'https://wa.me/573045233125', label: 'WhatsApp' },
