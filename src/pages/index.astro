      var ph=document.getElementById('bph').value.trim();
      var sj=document.getElementById('bsj').value.trim();
      var mg=document.getElementById('bmsg').value.trim();
      var ok=true;
      if(nm.length<2){ setE('bn','ebn',x.en); ok=false; } else setE('bn','ebn','');
      if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)){ setE('be2','ebe',x.ee); ok=false; } else setE('be2','ebe','');
      if(ph&&!/^[\+\d\s\-\(\)]{7,18}$/.test(ph)){ setE('bph','ebph',x.ep); ok=false; } else setE('bph','ebph','');
      if(sj.length<3){ setE('bsj','ebsj',x.es2); ok=false; } else setE('bsj','ebsj','');
