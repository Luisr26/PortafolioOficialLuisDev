    var widget=document.getElementById('bot-widget');
    var bubble=document.getElementById('bot-bubble');
    var msgEl=document.getElementById('bot-msg');
    var modal=document.getElementById('bot-modal');
    var form=document.getElementById('bot-form');
    var closeBtn=document.getElementById('bcl');
    var submitBtn=document.getElementById('bsub');
    var resEl=document.getElementById('bres');

    // === MESSAGES ===
    var used=[];
    function pickMsg(){
      var lang=localStorage.getItem('portfolio-lang')||'es';
      var list=MSGS[lang]||MSGS.es;
      if(used.length>=list.length) used=[];
      var avail=[]; for(var i=0;i<list.length;i++) if(used.indexOf(i)===-1) avail.push(i);
      var idx=avail[Math.floor(Math.random()*avail.length)];
      used.push(idx); return list[idx];
    }
    function showBubble(){
      msgEl.textContent=pickMsg();
      bubble.classList.remove('hide'); bubble.classList.add('show');
      setTimeout(function(){ bubble.classList.remove('show'); bubble.classList.add('hide'); }, 4500);
    }
    setTimeout(showBubble,2000);
    setInterval(showBubble,8000);

    // === MODAL ===
